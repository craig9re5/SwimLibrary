---
import BookCover from "../../components/BookCover.astro";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getAllBooks,
  getChapterSlug,
  getChaptersByBookSlug,
  calculateBookStats,
  type BookEntry,
  type ChapterEntry,
} from "../../lib/library";
import { withBase } from "../../lib/paths";

interface Props {
  book: BookEntry;
  chapters: ChapterEntry[];
}

export async function getStaticPaths() {
  const books = await getAllBooks();

  return Promise.all(
    books.map(async (book) => ({
      params: { slug: book.data.slug },
      props: {
        book,
        chapters: await getChaptersByBookSlug(book.data.slug),
      },
    })),
  );
}

const { book, chapters } = Astro.props;
const firstChapter = chapters[0];
const firstChapterHref = firstChapter
  ? withBase(`read/${book.data.slug}/${getChapterSlug(firstChapter)}/`)
  : withBase();
const updatedLabel = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(book.data.updated);

const bookStats = calculateBookStats(chapters);

// Prepare lightweight chapter content data for client-side EPUB/Markdown export
const exportChaptersData = chapters.map((c) => ({
  title: c.data.title,
  order: c.data.order,
  body: c.body || "",
}));
---

<BaseLayout title={book.data.title} description={book.data.summary}>
  <main
    id="main-content"
    class="book-page"
    style={{ "--book-accent": book.data.accent }}
  >
    <div class="shell book-detail">
      <div class="book-detail__cover reveal">
        <BookCover
          title={book.data.title}
          author={book.data.author}
          label={book.data.coverLabel}
          accent={book.data.accent}
          size="large"
        />
      </div>

      <article class="book-detail__content">
        <div class="book-detail__header-row reveal">
          <a class="book-detail__back" href={withBase("#library")}>
            <Icon name="chevron-left" size={15} />
            <span>返回馆藏</span>
          </a>
          <p class="book-detail__category">{book.data.category}</p>
        </div>
        <h1 class="reveal reveal--2">{book.data.title}</h1>
        <p class="book-detail__author reveal reveal--2">{book.data.author}</p>
        <p class="book-detail__summary reveal reveal--3">{book.data.summary}</p>

        <div class="book-detail__actions reveal reveal--3">
          <a
            class="button"
            href={firstChapterHref}
            data-primary-read
            data-book-slug={book.data.slug}
          >
            <Icon name="book-open" size={18} />
            <span data-primary-read-label>开始阅读</span>
          </a>
          <button
            class="button button--ghost favorite-button"
            type="button"
            data-favorite-button
            data-book-slug={book.data.slug}
            aria-pressed="false"
          >
            <Icon name="bookmark" size={17} />
            <span data-favorite-label>收藏本书</span>
          </button>
        </div>

        <div class="book-detail__export-row reveal reveal--3">
          <span class="export-label">全书离线与导出：</span>
          <div class="export-button-group">
            <button class="export-pill" type="button" data-export-epub>
              <Icon name="download" size={14} />
              <span>EPUB 电子书</span>
            </button>
            <button class="export-pill" type="button" data-export-md>
              <Icon name="file-text" size={14} />
              <span>Markdown</span>
            </button>
            <button class="export-pill" type="button" data-print-book>
              <Icon name="printer" size={14} />
              <span>打印 / 存为 PDF</span>
            </button>
          </div>
        </div>

        <dl class="book-detail__facts">
          <div>
            <dt>章节</dt>
            <dd>{chapters.length} 章</dd>
          </div>
          <div>
            <dt>总字数</dt>
            <dd>{bookStats.formattedTotal}</dd>
          </div>
          <div>
            <dt>预计耗时</dt>
            <dd>约 {bookStats.estimatedHours} 小时</dd>
          </div>
          <div>
            <dt>最近整理</dt>
            <dd>{updatedLabel}</dd>
          </div>
        </dl>
      </article>

      <section class="chapter-list" aria-labelledby="chapter-list-title">
        <h2 id="chapter-list-title">目录</h2>
        <ol>
          {
            chapters.map((chapter) => (
              <li>
                <a
                  class="chapter-link"
                  href={withBase(
                    `read/${book.data.slug}/${getChapterSlug(chapter)}/`,
                  )}
                >
                  <span class="chapter-link__title">{chapter.data.title}</span>
                  <span class="chapter-link__excerpt">
                    {chapter.data.excerpt ?? "阅读本章"}
                  </span>
                  <Icon name="chevron-right" size={17} />
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </main>

  <script
    is:inline
    define:vars={{
      baseUrl: import.meta.env.BASE_URL,
      bookTitle: book.data.title,
      bookAuthor: book.data.author,
      bookSummary: book.data.summary,
      bookSlug: book.data.slug,
      chaptersData: exportChaptersData,
    }}
  >
    (() => {
      const progressKey = "shiyue-progress";
      const favoritesKey = "shiyue-favorites";
      const readJson = (key, fallback) => {
        try {
          return JSON.parse(localStorage.getItem(key) || "") || fallback;
        } catch {
          return fallback;
        }
      };

      const readButton = document.querySelector("[data-primary-read]");
      const slug = readButton.dataset.bookSlug;
      const progress = readJson(progressKey, {});
      const saved = progress[slug];

      if (saved?.href) {
        readButton.href = baseUrl + String(saved.href).replace(/^\/+/, "");
        readButton.querySelector("[data-primary-read-label]").textContent =
          "继续阅读 · " + saved.chapterTitle;
      }

      const favoriteButton = document.querySelector("[data-favorite-button]");
      const favorites = new Set(readJson(favoritesKey, []));
      const renderFavorite = () => {
        const active = favorites.has(slug);
        favoriteButton.dataset.favorited = String(active);
        favoriteButton.setAttribute("aria-pressed", String(active));
        favoriteButton.querySelector("[data-favorite-label]").textContent =
          active ? "已收藏" : "收藏本书";
      };

      favoriteButton?.addEventListener("click", () => {
        if (favorites.has(slug)) favorites.delete(slug);
        else favorites.add(slug);
        try {
          localStorage.setItem(favoritesKey, JSON.stringify(Array.from(favorites)));
        } catch {}
        renderFavorite();
      });

      renderFavorite();

      // --- Export Handlers ---
      const exportEpubBtn = document.querySelector("[data-export-epub]");
      const exportMdBtn = document.querySelector("[data-export-md]");
      const printBtn = document.querySelector("[data-print-book]");

      // Export Markdown
      exportMdBtn?.addEventListener("click", () => {
        let mdContent = `# ${bookTitle}\n\n**作者**：${bookAuthor}\n\n**简介**：${bookSummary}\n\n---\n\n`;
        chaptersData.forEach((ch, idx) => {
          mdContent += `\n\n# 第 ${idx + 1} 章 ${ch.title}\n\n${ch.body}\n\n---\n`;
        });

        const blob = new Blob([mdContent], { type: "text/markdown;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `${bookTitle} - ${bookAuthor}.md`;
        a.click();
        URL.revokeObjectURL(url);
      });

      // Export EPUB using Pure JS EPUB Generator
      exportEpubBtn?.addEventListener("click", async () => {
        exportEpubBtn.disabled = true;
        const originalText = exportEpubBtn.innerHTML;
        exportEpubBtn.innerHTML = "<span>正在生成 EPUB...</span>";

        try {
          // Dynamic import our pure TS/JS epub generator
          const { generateEpub } = await import(`${baseUrl.replace(/\/+$/, "")}/src/lib/epub.ts?t=${Date.now()}`).catch(async () => {
            // Fallback module resolver
            return await import("../../lib/epub");
          });

          const epubBytes = generateEpub({
            title: bookTitle,
            author: bookAuthor,
            summary: bookSummary,
            chapters: chaptersData.map((c, i) => ({
              title: c.title,
              order: i + 1,
              htmlContent: c.body,
            })),
          });

          const blob = new Blob([epubBytes], { type: "application/epub+zip" });
          const url = URL.createObjectURL(blob);
          const a = document.createElement("a");
          a.href = url;
          a.download = `${bookTitle} - ${bookAuthor}.epub`;
          a.click();
          URL.revokeObjectURL(url);
        } catch (err) {
          console.error("EPUB export failed:", err);
          // Fallback to markdown download if module dynamic import fails
          exportMdBtn?.click();
        } finally {
          exportEpubBtn.innerHTML = originalText;
          exportEpubBtn.disabled = false;
        }
      });

      // Print / Save as PDF
      printBtn?.addEventListener("click", () => {
        window.print();
      });
    })();
  </script>
</BaseLayout>

