---
import { render } from "astro:content";
import Icon from "../../../components/Icon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getAllBooks,
  getChapterSlug,
  getChaptersByBookSlug,
  type BookEntry,
  type ChapterEntry,
} from "../../../lib/library";
import { withBase } from "../../../lib/paths";
import { calculateReadingStats } from "../../../lib/wordCount";

interface Props {
  book: BookEntry;
  chapter: ChapterEntry;
  chapters: ChapterEntry[];
  previous?: ChapterEntry;
  next?: ChapterEntry;
  chapterIndex: number;
}

export async function getStaticPaths() {
  const books = await getAllBooks();
  const nested = await Promise.all(
    books.map(async (book) => {
      const chapters = await getChaptersByBookSlug(book.data.slug);
      return chapters.map((chapter, chapterIndex) => ({
        params: {
          book: book.data.slug,
          chapter: getChapterSlug(chapter),
        },
        props: {
          book,
          chapter,
          chapters,
          previous: chapters[chapterIndex - 1],
          next: chapters[chapterIndex + 1],
          chapterIndex,
        },
      }));
    }),
  );

  return nested.flat();
}

const {
  book,
  chapter,
  chapters,
  previous,
  next,
  chapterIndex,
} = Astro.props;
const { Content, headings } = await render(chapter);
const sections = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const chapterSlug = getChapterSlug(chapter);
const bookHref = withBase(`books/${book.data.slug}/`);
const chapterHref = (entry: ChapterEntry) =>
  withBase(`read/${book.data.slug}/${getChapterSlug(entry)}/`);

const stats = calculateReadingStats(chapter.body || "");
---

<BaseLayout
  title={`${chapter.data.title} — ${book.data.title}`}
  description={chapter.data.excerpt ?? book.data.summary}
  hideChrome
  bodyClass="reader-body"
>
  <div class="reader-progress" aria-hidden="true">
    <span data-reader-progress></span>
  </div>

  <div id="reader-toast" class="reader-toast" role="status" aria-live="polite" hidden></div>

  <!-- Floating Exit Zen Mode Button -->
  <div class="zen-exit-wrap" data-zen-exit hidden>
    <button class="zen-exit-btn" type="button" data-zen-toggle aria-label="退出专注模式 (Esc / Z)">
      <Icon name="minimize" size={15} />
      <span>退出专注</span>
    </button>
  </div>

  <header class="reader-header" data-reader-header>
    <div class="reader-header__inner">
      <a class="reader-header__book" href={bookHref} title="返回书籍详情">
        <Icon name="chevron-left" size={17} />
        <span>{book.data.title}</span>
      </a>
      <span class="reader-header__chapter">{chapter.data.title}</span>
      <div class="reader-header__actions">
        <button
          class="icon-button"
          type="button"
          data-search-open
          aria-label="全站搜索 (Cmd+K)"
          title="全站搜索 (Cmd+K)"
        >
          <Icon name="search" size={18} />
        </button>

        <button
          class="icon-button zen-toggle-btn"
          type="button"
          data-zen-toggle
          aria-label="专注模式 (快捷键 Z)"
          title="专注模式 (快捷键 Z)"
        >
          <Icon name="maximize" size={18} />
        </button>

        <button
          class="icon-button mobile-toc-button"
          type="button"
          data-dialog-open="toc-dialog"
          aria-label="打开章节目录"
        >
          <Icon name="menu" size={19} />
        </button>

        <div class="reader-settings-anchor">
          <button
            class="icon-button"
            type="button"
            data-settings-toggle
            aria-expanded="false"
            aria-controls="settings-popover"
            aria-label="阅读设置"
          >
            <Icon name="settings" size={19} />
          </button>

          <div
            class="reader-settings-popover"
            id="settings-popover"
            role="region"
            aria-label="阅读设置"
            hidden
          >
            <div class="reader-settings-popover__header">
              <span class="reader-settings-popover__title">阅读偏好</span>
              <button
                class="reader-settings-popover__close"
                type="button"
                data-settings-close
                aria-label="关闭阅读设置"
              >
                <Icon name="close" size={14} />
              </button>
            </div>

            <div class="reader-settings-popover__body">
              <label class="range-control">
                <span class="range-control__label">
                  <span>字号</span>
                  <output data-font-size-output class="range-control__badge">19 px</output>
                </span>
                <input data-reader-font-size type="range" min="17" max="24" step="1" value="19" />
              </label>

              <label class="range-control">
                <span class="range-control__label">
                  <span>行高</span>
                  <output data-line-height-output class="range-control__badge">1.85</output>
                </span>
                <input data-reader-line-height type="range" min="1.65" max="2.2" step="0.05" value="1.85" />
              </label>

              <label class="range-control">
                <span class="range-control__label">
                  <span>每行字数</span>
                  <output data-reader-width-output class="range-control__badge">36 字/行</output>
                </span>
                <input data-reader-width type="range" min="26" max="42" step="1" value="36" />
              </label>

              <div class="reader-settings-theme">
                <span class="range-control__label">
                  <span>阅读主题</span>
                </span>
                <div class="theme-choice theme-choice--3">
                  <button type="button" data-theme-choice="system" aria-pressed="false">跟随系统</button>
                  <button type="button" data-theme-choice="light" aria-pressed="false">日读</button>
                  <button type="button" data-theme-choice="dark" aria-pressed="false">夜读</button>
                </div>
              </div>

              <div class="reader-settings-data">
                <span class="range-control__label">
                  <span>数据与备份</span>
                </span>
                <div class="reader-data-actions">
                  <button class="reader-data-btn" type="button" data-export-backup>
                    <Icon name="download" size={14} />
                    <span>导出阅读记录 (JSON)</span>
                  </button>
                  <label class="reader-data-btn reader-data-btn--file">
                    <Icon name="upload" size={14} />
                    <span>导入备份记录</span>
                    <input type="file" accept=".json" data-import-backup hidden />
                  </label>
                  <button class="reader-data-btn reader-data-btn--danger" type="button" data-reset-progress>
                    <span>清除本站阅读记录</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <button class="icon-button" type="button" data-theme-toggle aria-label="切换明暗主题">
          <span class="theme-icon--moon"><Icon name="moon" size={18} /></span>
          <span class="theme-icon--sun"><Icon name="sun" size={18} /></span>
        </button>
      </div>
    </div>
  </header>

  <main
    id="main-content"
    class="reader-shell"
    data-reader-shell
    data-book-slug={book.data.slug}
    data-chapter-slug={chapterSlug}
    data-chapter-index={chapterIndex}
    data-chapter-count={chapters.length}
  >
    <aside class="reader-toc" aria-label="章节目录">
      <a class="reader-toc__back" href={bookHref}>
        <Icon name="chevron-left" size={15} />
        返回书籍详情
      </a>
      <h2>{book.data.title}</h2>
      <ol class="reader-toc__list">
        {
          chapters.map((entry) => (
            <li>
              <a
                href={chapterHref(entry)}
                aria-current={entry.id === chapter.id ? "page" : undefined}
                class="reader-toc__chap-link"
              >
                {entry.data.title}
              </a>
              {entry.id === chapter.id && sections.length > 0 && (
                <ol class="reader-toc__sections">
                  {sections.map((section) => (
                    <li class:list={[{ "reader-toc__sec--sub": section.depth === 3 }]}>
                      <a href={`#${section.slug}`} data-section-link={section.slug}>
                        {section.text}
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))
        }
      </ol>
    </aside>

    <div class="reader-main">
      <article class="reader-article" data-reader-article>
        <div class="reader-article__header">
          <div class="reader-article__meta-row">
            <p class="reader-article__kicker">
              第 {String(chapterIndex + 1).padStart(2, "0")} 章 · {book.data.title}
            </p>
            <span class="reader-article__stats">
              <Icon name="clock" size={13} />
              <span>{stats.formattedCount} · 约 {stats.readingTimeMinutes} 分钟</span>
            </span>
          </div>
          <h1>{chapter.data.title}</h1>
        </div>
        <div class="reader-prose" data-reader-prose>
          <Content />
        </div>
      </article>

      <nav class="reader-navigation" aria-label="章节导航">
        {
          previous ? (
            <a class="reader-nav-link" href={chapterHref(previous)} data-previous-chapter>
              <Icon name="chevron-left" size={19} />
              <span>
                上一章
                <strong>{previous.data.title}</strong>
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a
              class="reader-nav-link reader-nav-link--next"
              href={chapterHref(next)}
              data-next-chapter
            >
              <span>
                下一章
                <strong>{next.data.title}</strong>
              </span>
              <Icon name="chevron-right" size={19} />
            </a>
          ) : (
            <a class="reader-nav-link reader-nav-link--next" href={bookHref}>
              <span>
                本书读完
                <strong>返回书籍详情</strong>
              </span>
              <Icon name="chevron-right" size={19} />
            </a>
          )
        }
      </nav>
    </div>
  </main>

  <dialog class="reader-dialog" id="toc-dialog" aria-labelledby="toc-dialog-title">
    <div class="reader-dialog__header">
      <h2 id="toc-dialog-title">章节目录</h2>
      <button class="icon-button" type="button" data-dialog-close aria-label="关闭章节目录">
        <Icon name="close" size={19} />
      </button>
    </div>
    <div class="reader-dialog__body">
      <nav class="reader-dialog-toc" aria-label="移动端章节目录">
        {
          chapters.map((entry) => (
            <Fragment>
              <a
                href={chapterHref(entry)}
                aria-current={entry.id === chapter.id ? "page" : undefined}
              >
                <span>{String(entry.data.order).padStart(2, "0")}</span>
                {entry.data.title}
              </a>
              {entry.id === chapter.id && sections.length > 0 && (
                <ol class="reader-toc__sections">
                  {sections.map((section) => (
                    <li class:list={[{ "reader-toc__sec--sub": section.depth === 3 }]}>
                      <a href={`#${section.slug}`} data-dialog-close>
                        {section.text}
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </Fragment>
          ))
        }
      </nav>
    </div>
  </dialog>

  <script
    is:inline
    define:vars={{
      baseUrl: import.meta.env.BASE_URL,
      bookSlug: book.data.slug,
      bookTitle: book.data.title,
      chapterSlug,
      chapterTitle: chapter.data.title,
      chapterIndex,
      chapterCount: chapters.length,
    }}
  >
    (() => {
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";

      const progressKey = "shiyue-progress";
      const settingsKey = "shiyue-reader-settings";
      const favoritesKey = "shiyue-favorites";
      const shell = document.querySelector("[data-reader-shell]");
      const article = document.querySelector("[data-reader-article]");
      const prose = document.querySelector("[data-reader-prose]");
      const header = document.querySelector("[data-reader-header]");
      const progressBar = document.querySelector("[data-reader-progress]");
      const fontInput = document.querySelector("[data-reader-font-size]");
      const lineInput = document.querySelector("[data-reader-line-height]");
      const widthInput = document.querySelector("[data-reader-width]");
      const toastEl = document.getElementById("reader-toast");
      const zenExitWrap = document.querySelector("[data-zen-exit]");
      let ticking = false;

      const showToast = (msg, duration = 2400) => {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.hidden = false;
        toastEl.classList.add("is-visible");
        setTimeout(() => {
          toastEl.classList.remove("is-visible");
          setTimeout(() => { toastEl.hidden = true; }, 300);
        }, duration);
      };

      const readJson = (key, fallback) => {
        try {
          return JSON.parse(localStorage.getItem(key) || "") || fallback;
        } catch {
          return fallback;
        }
      };

      const settings = {
        fontSize: 19,
        lineHeight: 1.85,
        width: 36,
        zenMode: false,
        ...readJson(settingsKey, {}),
      };

      settings.fontSize = Math.min(24, Math.max(17, Math.round(Number(settings.fontSize) || 19)));
      settings.lineHeight = Math.min(2.2, Math.max(1.65, Number(settings.lineHeight) || 1.85));
      settings.width = Number(settings.width) || 36;
      settings.width = Math.min(
        42,
        Math.max(26, Math.round(settings.width > 42 ? settings.width / 2 : settings.width)),
      );

      const applySettings = () => {
        shell.style.setProperty("--reader-font-size", settings.fontSize + "px");
        shell.style.setProperty("--reader-line-height", String(settings.lineHeight));
        shell.style.setProperty("--reader-measure", String(settings.width));
        fontInput.value = settings.fontSize;
        lineInput.value = settings.lineHeight;
        widthInput.value = settings.width;
        document.querySelector("[data-font-size-output]").textContent =
          settings.fontSize + " px";
        document.querySelector("[data-line-height-output]").textContent =
          Number(settings.lineHeight).toFixed(2);
        document.querySelector("[data-reader-width-output]").textContent =
          settings.width + " 字/行";
      };

      const saveSettings = () => {
        try {
          localStorage.setItem(settingsKey, JSON.stringify(settings));
        } catch {}
      };

      fontInput.addEventListener("input", () => {
        settings.fontSize = Number(fontInput.value);
        applySettings();
        saveSettings();
      });

      lineInput.addEventListener("input", () => {
        settings.lineHeight = Number(lineInput.value);
        applySettings();
        saveSettings();
      });

      widthInput.addEventListener("input", () => {
        settings.width = Number(widthInput.value);
        applySettings();
        saveSettings();
      });

      // --- Zen Focus Mode ---
      const toggleZenMode = (forcedState) => {
        const isZen = forcedState !== undefined ? forcedState : !document.body.classList.contains("zen-mode");
        document.body.classList.toggle("zen-mode", isZen);
        if (zenExitWrap) zenExitWrap.hidden = !isZen;
        if (isZen) {
          showToast("已开启专注模式（按 Z 或 ESC 退出）", 2000);
        }
      };

      document.querySelectorAll("[data-zen-toggle]").forEach((btn) => {
        btn.addEventListener("click", () => toggleZenMode());
      });

      // --- Settings Popover ---
      const settingsToggle = document.querySelector("[data-settings-toggle]");
      const settingsPopover = document.getElementById("settings-popover");
      const settingsClose = document.querySelector("[data-settings-close]");

      const openSettings = () => {
        if (!settingsPopover) return;
        settingsPopover.hidden = false;
        settingsToggle?.setAttribute("aria-expanded", "true");
      };

      const closeSettings = () => {
        if (!settingsPopover) return;
        settingsPopover.hidden = true;
        settingsToggle?.setAttribute("aria-expanded", "false");
      };

      const toggleSettings = () => {
        if (settingsPopover?.hidden) {
          openSettings();
        } else {
          closeSettings();
        }
      };

      settingsToggle?.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleSettings();
      });

      settingsClose?.addEventListener("click", (e) => {
        e.stopPropagation();
        closeSettings();
      });

      document.addEventListener("click", (e) => {
        if (
          settingsPopover &&
          !settingsPopover.hidden &&
          !settingsPopover.contains(e.target) &&
          !settingsToggle?.contains(e.target)
        ) {
          closeSettings();
        }
      });

      // --- Data Backup & Restore ---
      const exportBackupBtn = document.querySelector("[data-export-backup]");
      const importBackupInput = document.querySelector("[data-import-backup]");
      const resetProgressBtn = document.querySelector("[data-reset-progress]");

      exportBackupBtn?.addEventListener("click", () => {
        const data = {
          version: 1,
          timestamp: new Date().toISOString(),
          progress: readJson(progressKey, {}),
          favorites: readJson(favoritesKey, []),
          settings: readJson(settingsKey, {}),
        };
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = `swim-library-backup-${new Date().toISOString().split("T")[0]}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast("已成功导出备份文件！");
      });

      importBackupInput?.addEventListener("change", (e) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (event) => {
          try {
            const imported = JSON.parse(event.target.result);
            if (imported.progress) localStorage.setItem(progressKey, JSON.stringify(imported.progress));
            if (imported.favorites) localStorage.setItem(favoritesKey, JSON.stringify(imported.favorites));
            if (imported.settings) localStorage.setItem(settingsKey, JSON.stringify(imported.settings));
            showToast("数据恢复成功，正在刷新...");
            setTimeout(() => window.location.reload(), 800);
          } catch (err) {
            alert("导入失败：无效的 JSON 备份文件格式。");
          }
        };
        reader.readAsText(file);
      });

      resetProgressBtn?.addEventListener("click", () => {
        if (confirm("确定要清空本站的所有阅读进度与偏好设置吗？此操作无法撤销。")) {
          localStorage.removeItem(progressKey);
          localStorage.removeItem(favoritesKey);
          localStorage.removeItem(settingsKey);
          showToast("阅读数据已全部重置");
          setTimeout(() => window.location.reload(), 600);
        }
      });

      // Dialog controls
      document.querySelectorAll("[data-dialog-open]").forEach((button) => {
        button.addEventListener("click", () => {
          document.getElementById(button.dataset.dialogOpen)?.showModal();
        });
      });

      document.querySelectorAll("[data-dialog-close]").forEach((button) => {
        button.addEventListener("click", () => button.closest("dialog")?.close());
      });

      document.querySelectorAll("dialog").forEach((dialog) => {
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });

      // Tag paragraph blocks for precise scroll anchor recovery
      const paragraphs = Array.from(
        prose?.querySelectorAll("p, h2, h3, blockquote, ul, ol") || [],
      );
      paragraphs.forEach((el, index) => {
        el.dataset.paraIdx = String(index);
      });

      // Cache geometry
      const geom = { top: 0, height: 1 };
      const measure = () => {
        geom.top = article.getBoundingClientRect().top + window.scrollY;
        geom.height = Math.max(1, article.offsetHeight);
      };

      // Progress flush throttling
      let pendingProgress = null;
      let flushTimer = 0;

      const getActiveParagraphIndex = () => {
        const viewCenter = window.scrollY + window.innerHeight * 0.35;
        let activeIdx = 0;
        for (let i = 0; i < paragraphs.length; i++) {
          const rect = paragraphs[i].getBoundingClientRect();
          const top = rect.top + window.scrollY;
          if (top <= viewCenter) {
            activeIdx = i;
          } else {
            break;
          }
        }
        return activeIdx;
      };

      const flushProgress = () => {
        if (flushTimer) {
          clearTimeout(flushTimer);
          flushTimer = 0;
        }
        if (!pendingProgress) return;
        const snapshot = pendingProgress;
        pendingProgress = null;
        const allProgress = readJson(progressKey, {});
        allProgress[bookSlug] = {
          bookTitle,
          chapterTitle,
          chapter: chapterSlug,
          progress: snapshot.overallProgress,
          chapterProgress: snapshot.chapterProgress,
          paragraphIndex: snapshot.paragraphIndex,
          href: "read/" + bookSlug + "/" + chapterSlug + "/",
          updatedAt: Date.now(),
        };
        try {
          localStorage.setItem(progressKey, JSON.stringify(allProgress));
        } catch {}
      };

      const saveProgress = (chapterProgress, overallProgress) => {
        const paragraphIndex = getActiveParagraphIndex();
        pendingProgress = { chapterProgress, overallProgress, paragraphIndex };
        if (flushTimer) clearTimeout(flushTimer);
        flushTimer = setTimeout(flushProgress, 600);
      };

      document.addEventListener("visibilitychange", () => {
        if (document.hidden) flushProgress();
      });

      window.addEventListener("pagehide", flushProgress);

      const updateReadingState = () => {
        const y = window.scrollY;
        const chapterProgress = Math.max(
          0,
          Math.min(100, ((y + window.innerHeight - geom.top) / geom.height) * 100),
        );
        const overallProgress =
          ((chapterIndex + chapterProgress / 100) / chapterCount) * 100;
        progressBar.style.setProperty("--reading-progress", chapterProgress + "%");

        header.dataset.scrolled = String(y > 20);

        saveProgress(chapterProgress, overallProgress);
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            requestAnimationFrame(updateReadingState);
            ticking = true;
          }
        },
        { passive: true },
      );

      window.addEventListener("resize", () => {
        measure();
        updateReadingState();
      });

      if ("ResizeObserver" in window) {
        new ResizeObserver(() => {
          measure();
          updateReadingState();
        }).observe(article);
      }

      // --- Heading in-view tracking for Table of Contents ---
      const headingElements = Array.from(prose?.querySelectorAll("h2, h3") || []);
      if ("IntersectionObserver" in window && headingElements.length > 0) {
        const headingObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const id = entry.target.getAttribute("id");
                if (id) {
                  document.querySelectorAll("[data-section-link]").forEach((link) => {
                    link.classList.toggle("is-active", link.dataset.sectionLink === id);
                  });
                }
              }
            });
          },
          { rootMargin: "-10% 0px -70% 0px" },
        );
        headingElements.forEach((h) => headingObserver.observe(h));
      }

      // Keyboard Shortcuts
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          if (settingsPopover && !settingsPopover.hidden) {
            closeSettings();
            return;
          }
          if (document.body.classList.contains("zen-mode")) {
            toggleZenMode(false);
            return;
          }
        }
        if (
          event.altKey ||
          event.ctrlKey ||
          event.metaKey ||
          document.querySelector("dialog[open]") ||
          (settingsPopover && !settingsPopover.hidden) ||
          ["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName)
        ) {
          return;
        }

        if (event.key === "z" || event.key === "Z" || event.key === "f" || event.key === "F") {
          event.preventDefault();
          toggleZenMode();
          return;
        }

        if (event.key === "ArrowLeft") {
          document.querySelector("[data-previous-chapter]")?.click();
        }
        if (event.key === "ArrowRight") {
          document.querySelector("[data-next-chapter]")?.click();
        }
      });

      applySettings();
      measure();

      // Paragraph anchor restoration
      const saved = readJson(progressKey, {})[bookSlug];
      if (
        saved?.chapter === chapterSlug &&
        !window.location.hash
      ) {
        requestAnimationFrame(() => {
          measure();
          if (saved.paragraphIndex !== undefined && paragraphs[saved.paragraphIndex]) {
            paragraphs[saved.paragraphIndex].scrollIntoView({ behavior: "auto", block: "start" });
            window.scrollBy({ top: -80, behavior: "auto" });
            showToast("已恢复至上次阅读位置", 2200);
          } else if (saved.chapterProgress > 2 && saved.chapterProgress < 97) {
            window.scrollTo({
              top:
                geom.top +
                geom.height * (saved.chapterProgress / 100) -
                window.innerHeight,
              behavior: "auto",
            });
          }
          updateReadingState();
        });
      } else {
        updateReadingState();
      }
    })();
  </script>
</BaseLayout>

