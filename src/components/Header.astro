---
import Icon from "./Icon.astro";
import { withBase } from "../lib/paths";
import { siteConfig } from "../site.config";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";

const currentPath = normalizePath(Astro.url.pathname);
const isHome = currentPath === normalizePath(withBase());
const isAbout = currentPath === normalizePath(withBase("about/"));
---

<header class:list={["site-header", { "site-header--overlay": overlay }]}>
  <div class="site-header__inner">
    <a class="brand" href={withBase()} aria-label={`${siteConfig.englishName}首页`}>
      <span class="brand__icon" aria-hidden="true">
        <Icon name="wave-book" size={21} />
      </span>
      <span class="brand__name" lang="en">{siteConfig.englishName}</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      <a class="site-nav__link" href={withBase("#library")} aria-current={isHome ? "location" : undefined}>馆藏</a>
      <a class="site-nav__link" href={withBase("about/")} aria-current={isAbout ? "page" : undefined}>关于</a>
      <a class="icon-button" href={withBase("#library-search")} aria-label="搜索馆藏">
        <Icon name="search" size={19} />
      </a>
      <button class="icon-button" type="button" data-theme-toggle aria-label="切换主题模式">
        <span class="theme-icon--moon"><Icon name="moon" size={19} /></span>
        <span class="theme-icon--sun"><Icon name="sun" size={19} /></span>
      </button>
    </nav>
  </div>
</header>
