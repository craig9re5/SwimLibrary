---
interface Props {
  title: string;
  author: string;
  label: string;
  accent: string;
  size?: "regular" | "large";
}

const {
  title,
  author,
  label,
  accent,
  size = "regular",
} = Astro.props;

const channel = (value: number) => {
  const srgb = value / 255;
  return srgb <= 0.04045 ? srgb / 12.92 : ((srgb + 0.055) / 1.055) ** 2.4;
};

const relativeLuminance = (hex: string) => {
  const [r, g, b] = [1, 3, 5].map((index) =>
    channel(parseInt(hex.slice(index, index + 2), 16)),
  );
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};

// 深底配奶白墨、浅底配深墨：阈值 0.1706 保证正文对底色至少 4.5:1。
const useCreamInk = relativeLuminance(accent) <= 0.1706;
const ink = useCreamInk ? "#fff8e9" : "#251e15";
const inkAccent = useCreamInk
  ? "rgba(255, 248, 233, 0.55)"
  : "rgba(37, 30, 21, 0.45)";
---

<div
  class:list={[
    "book-cover",
    {
      "book-cover--large": size === "large",
    },
  ]}
  style={`--cover-bg: ${accent}; --cover-ink: ${ink}; --cover-accent: ${inkAccent};`}
  aria-hidden="true"
>
  <span class="book-cover__label">{label}</span>
  <strong class="book-cover__title">{title}</strong>
  <p class="book-cover__author">{author}</p>
</div>
