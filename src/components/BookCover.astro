---
interface Props {
  title: string;
  author: string;
  label: string;
  accent: string;
  size?: "regular" | "large";
}

import { getCoverInkColors } from "../lib/color";

const {
  title,
  author,
  label,
  accent,
  size = "regular",
} = Astro.props;

const { ink, inkAccent } = getCoverInkColors(accent);
---

<div
  class:list={[
    "book-cover",
    {
      "book-cover--large": size === "large",
    },
  ]}
  style={`--cover-bg: ${accent}; --cover-ink: ${ink}; --cover-accent: ${inkAccent};`}
  aria-hidden="true"
>
  <span class="book-cover__label">{label}</span>
  <strong class="book-cover__title">{title}</strong>
  <p class="book-cover__author">{author}</p>
</div>
