---
interface Props {
  name:
    | "arrow-right"
    | "bilibili"
    | "bookmark"
    | "book-open"
    | "check"
    | "chevron-left"
    | "chevron-right"
    | "clock"
    | "close"
    | "database"
    | "download"
    | "file-text"
    | "github"
    | "maximize"
    | "menu"
    | "minimize"
    | "monitor"
    | "moon"
    | "printer"
    | "search"
    | "settings"
    | "sun"
    | "upload"
    | "wave-book";
  size?: number;
  strokeWidth?: number;
}

const { name, size = 20, strokeWidth = 1.8 } = Astro.props;

// The viewBox is a fixed 24 grid while `size` varies (15–22) across the site, so a
// literal stroke-width would render thinner on small icons and thicker on large ones.
// Scale it back up by 24 / size so every icon lands at the same optical thickness,
// clamped so very small sizes cannot produce an absurdly heavy stroke.
const renderedStrokeWidth = Math.min(2.6, (strokeWidth * 24) / size);

const paths: Record<Props["name"], string> = {
  "arrow-right": '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  bilibili:
    '<path d="m8.5 3.5 2.4 2.7M15.5 6.2l2.4-2.7"/><rect x="3" y="6.5" width="18" height="14" rx="3"/><path d="M8.5 11.5v3M15.5 11.5v3"/>',
  bookmark:
    '<path d="M6 4.75A1.75 1.75 0 0 1 7.75 3h8.5A1.75 1.75 0 0 1 18 4.75V21l-6-3.6L6 21Z"/>',
  "book-open":
    '<path d="M2.5 5.5A3.5 3.5 0 0 1 6 2h5v17H6a3.5 3.5 0 0 0-3.5 3.5Z"/><path d="M21.5 5.5A3.5 3.5 0 0 0 18 2h-5v17h5a3.5 3.5 0 0 1 3.5 3.5Z"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
  "chevron-left": '<path d="m15 18-6-6 6-6"/>',
  "chevron-right": '<path d="m9 18 6-6-6-6"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  database:
    '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
  download:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>',
  "file-text":
    '<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  maximize:
    '<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  minimize:
    '<path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/>',
  monitor: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M9 21h6M12 17v4"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/>',
  printer:
    '<polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
  settings:
    '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
  sun:
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/>',
  upload:
    '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>',
  "wave-book":
    '<path d="M12 4.5c-3.2-2-6.8-1.8-9.5.8v11.2c2.7-2.6 6.3-2.8 9.5-.8 3.2-2 6.8-1.8 9.5.8V5.3c-2.7-2.6-6.3-2.8-9.5-.8Z"/><path d="M12 4.5v15.2"/><path d="M2.5 19.8c2.8-1.6 5.8-1.4 9.5.2 3.7-1.6 6.7-1.8 9.5-.2"/>',
};
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={renderedStrokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={paths[name]}
/>
