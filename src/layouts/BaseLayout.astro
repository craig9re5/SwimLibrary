---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SearchModal from "../components/SearchModal.astro";
import { siteConfig } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  hideChrome?: boolean;
  hideFooter?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = siteConfig.description,
  overlayHeader = false,
  hideChrome = false,
  hideFooter = false,
  bodyClass = "",
} = Astro.props;

const pageTitle = title
  ? `${title} · ${siteConfig.name}`
  : `${siteConfig.englishName} · ${siteConfig.name}`;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : undefined;
const bodyClasses = bodyClass.split(/\s+/);
const isAboutPage = bodyClasses.includes("about-page");
const isReaderPage = bodyClasses.includes("reader-body");
const lightThemeColor = isAboutPage
  ? "#030817"
  : isReaderPage
    ? "#f9fcfd"
    : "#eaf1f5";
const darkThemeColor = isReaderPage ? "#111b2c" : "#0b1220";
---

<!doctype html>
<html lang="zh-CN" class:list={{ "fixed-dark-page": isAboutPage }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={lightThemeColor} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg?v=4`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon.svg?v=4`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.webmanifest?v=4`} />
    <title>{pageTitle}</title>
    <script is:inline define:vars={{ lightThemeColor, darkThemeColor, baseUrl: import.meta.env.BASE_URL }}>
      (() => {
        // Register Service Worker for PWA
        if ("serviceWorker" in navigator && window.location.protocol.startsWith("http")) {
          window.addEventListener("load", () => {
            const swUrl = (baseUrl.replace(/\/+$/, "") + "/sw.js").replace(/^\/\//, "/");
            navigator.serviceWorker.register(swUrl).catch((err) => {
              console.warn("[SW] Registration error:", err);
            });
          });
        }

        const paintMeta = (theme) => {
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              "content",
              theme === "dark" ? darkThemeColor : lightThemeColor,
            );
        };

        try {
          const media = window.matchMedia("(prefers-color-scheme: dark)");
          const resolve = (pref) =>
            pref === "light" || pref === "dark"
              ? pref
              : media.matches
                ? "dark"
                : "light";
          const apply = (pref) => {
            const theme = resolve(pref);
            document.documentElement.dataset.theme = theme;
            document.documentElement.dataset.themePref = pref;
            paintMeta(theme);
          };
          const storedPref = () => {
            const saved = localStorage.getItem("shiyue-theme");
            return saved === "light" || saved === "dark" ? saved : "system";
          };

          apply(storedPref());

          media.addEventListener("change", () => {
            try {
              if (storedPref() === "system") {
                apply("system");
              }
            } catch {}
          });
        } catch {
          document.documentElement.dataset.theme = "light";
          document.documentElement.dataset.themePref = "system";
        }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    {!hideChrome && <Header overlay={overlayHeader} />}
    <slot />
    {!hideChrome && !hideFooter && <Footer />}
    <SearchModal />


    <script is:inline define:vars={{ lightThemeColor, darkThemeColor }}>
      (() => {
        const root = document.documentElement;

        const resolve = (pref) => {
          if (pref === "light" || pref === "dark") return pref;
          try {
            return window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          } catch {
            return "light";
          }
        };

        const syncChoices = (pref) => {
          document.querySelectorAll("[data-theme-choice]").forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.themeChoice === pref),
            );
          });
        };

        const syncToggles = (pref) => {
          let label = "当前：跟随系统，点击切换为日间模式";
          if (pref === "light") label = "当前：日间模式，点击切换为夜间模式";
          else if (pref === "dark") label = "当前：夜间模式，点击恢复跟随系统";
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-label", label);
            button.setAttribute("title", label);
          });
        };

        const setTheme = (choice) => {
          const pref = choice === "light" || choice === "dark" ? choice : "system";
          try {
            if (pref === "system") {
              localStorage.removeItem("shiyue-theme");
            } else {
              localStorage.setItem("shiyue-theme", pref);
            }
          } catch {}
          const theme = resolve(pref);
          root.dataset.theme = theme;
          root.dataset.themePref = pref;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute(
              "content",
              theme === "dark" ? darkThemeColor : lightThemeColor,
            );
          syncChoices(pref);
          syncToggles(pref);
        };

        document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
          button.addEventListener("click", () => {
            const currentPref = root.dataset.themePref || "system";
            const nextPref =
              currentPref === "system"
                ? "light"
                : currentPref === "light"
                  ? "dark"
                  : "system";
            setTheme(nextPref);
          });
        });

        document.querySelectorAll("[data-theme-choice]").forEach((button) => {
          button.addEventListener("click", () => setTheme(button.dataset.themeChoice));
        });

        syncChoices(root.dataset.themePref || "system");
        syncToggles(root.dataset.themePref || "system");

        const markReady = () => root.classList.add("theme-ready");
        if (typeof requestAnimationFrame === "function") {
          requestAnimationFrame(() => requestAnimationFrame(markReady));
          // 后台标签页里 rAF 可能一直不触发，用定时器兜底（markReady 幂等）
          setTimeout(markReady, 300);
        } else {
          markReady();
        }
      })();
    </script>
  </body>
</html>
